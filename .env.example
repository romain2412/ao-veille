POSTGRES_DB=ao_veille
POSTGRES_USER=ao_user
# Mot de passe Postgres — générer une valeur robuste, ex :
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=changeme_mot_de_passe_fort
DATABASE_URL=postgresql+asyncpg://ao_user:changeme_mot_de_passe_fort@db:5432/ao_veille
# Clé de signature JWT — OBLIGATOIRE, le démarrage échoue si absente ou "changeme*".
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=changeme-secret-key-very-long-and-random
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Origines autorisées par l'API (CORS), séparées par des virgules.
# En prod, mettre l'URL réelle du frontend, ex : http://212.227.75.168
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Sources à collecter au démarrage (vide = toutes). Le scheduler collecte
# toujours toutes les sources, quel que soit ce réglage.
# Ex: COLLECT_START_SOURCES=boamp,noalis
COLLECT_START_SOURCES=
